# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Required for saving audits/leads (server only — never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — AI summary (template fallback if empty)
ANTHROPIC_API_KEY=

# Optional — confirmation email after lead capture
RESEND_API_KEY=

# Public URL for share links and OG tags (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
